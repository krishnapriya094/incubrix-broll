# ---- runtime ---------------------------------------------------------------
DATA_DIR=./data
MOCK_MODE=true
STORAGE_BACKEND=local
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
WORKER_THREADS=2
MAX_AUDIO_SECONDS=600

# ---- S3 / MinIO (used when STORAGE_BACKEND=s3) -----------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=incubrix-broll
S3_REGION=us-east-1

# ---- providers (set MOCK_MODE=false to use these) --------------------------
STT_BACKEND=faster_whisper
TTS_BACKEND=piper
EMBEDDINGS_BACKEND=fastembed
FOOTAGE_SOURCES=pexels
WHISPER_MODEL=base
PIPER_VOICE=./piper_voices/en_US-lessac-medium.onnx
EMBED_MODEL=BAAI/bge-small-en-v1.5

PEXELS_API_KEY=
PIXABAY_API_KEY=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
TTS_MODEL=tts-1
LLM_MODEL=gpt-4o-mini

# ---- media -----------------------------------------------------------------
FFMPEG_BINARY=ffmpeg
